PORT=5000
MONGO_URI=mongodb+srv://your_username:your_percent_encoded_password@your-cluster.mongodb.net/your_database?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# --- Disease prediction provider ---
# The predicted condition is always grounded by the Python ML engine (validated
# SymptomDiseaseClassifier) with the local heuristic overlap engine as fallback.
# 'gemini' (default) additionally uses Google Gemini to EXPLAIN the candidate
# conditions (supporting/missing symptoms, self-care, warning signs).
# Set to 'ml' to disable external Gemini calls and use local rule-based
# explanations only.
PREDICTION_PROVIDER=gemini

# Server-side only — NEVER prefix with VITE_ and never commit a real key.
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: override the Gemini model (defaults to the current stable Flash model)
GEMINI_MODEL=gemini-3.6-flash

# Optional: base URL of the Python ML microservice used as fallback (default: http://localhost:8000)
ML_SERVICE_URL=http://localhost:8000
